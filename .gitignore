"# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
env/
ENV/
.venv

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb_checkpoints/

# Data files (don't commit large datasets)
data/raw/*.csv
data/raw/*.xlsx
data/raw/*.json
*.parquet

# Models (add specific models if needed)
models/*.h5
# Allow essential pkl files for deployment
!models/churn_model_*.pkl
!models/scaler.pkl
!models/segmentation_model.pkl

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment variables
.env
.env.local

# Logs
logs/
*.log

# Reports (commit templates, not generated ones)
reports/*.pdf
reports/*.docx
reports/analysis/

# Figures (generated visualizations)
figures/eda/*.html
figures/eda/*.png
figures/model/*.html
figures/model/*.png
figures/segmentation/*.html
figures/segmentation/*.png

# Processed data
# Allow cleaned_data.csv for deployment
!data/processed/cleaned_data.csv
data/segments/*.csv

# Streamlit
# Allow config for deployment
!.streamlit/config.toml

# Cache
.cache/
*.cache

# Pytest
.pytest_cache/

# Coverage
.coverage
htmlcov/

# MyPy
.mypy_cache/

# Temporary files
*.tmp
*.bak
*.swp"